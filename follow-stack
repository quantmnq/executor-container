set -euo pipefail
umask 077
release_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
exec /usr/bin/python3.12 -I -S "$release_dir/scripts/stack-bootstrap.py" "$@"
